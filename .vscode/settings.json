{
  "mcp": {
    "servers": {
      "context7": {
        "command": "npx",
        "args": [
          "-y",
          "@context7/mcp-server"
        ],
        "env": {}
      },
      "token-cache": {
        "command": "node",
        "args": [
          "d:\\sarfu_works\\tokenshield\\dist\\cache-server.js",
          "d:\\sarfu_works\\tokenshield"
        ],
        "type": "stdio"
      },
      "headroom": {
        "command": "C:\\Users\\A644097\\.local\\bin\\headroom.exe",
        "args": [
          "mcp",
          "serve"
        ],
        "type": "stdio"
      }
    }
  },
  "github.copilot.chat.codesearch.exclude": {
    "*.lock": true,
    "*.min.js": true,
    "*.min.css": true,
    "*.map": true,
    "*.d.ts": true,
    "*.generated.*": true,
    "dist/**": true,
    "build/**": true,
    "coverage/**": true,
    ".git/**": true,
    "node_modules/**": true,
    ".next/**": true,
    ".nuxt/**": true,
    "__pycache__/**": true,
    "*.pyc": true,
    "*.pyo": true,
    "target/**": true,
    "vendor/**": true,
    "package-lock.json": true,
    "yarn.lock": true,
    "pnpm-lock.yaml": true,
    ".yarn/**": true
  },
  "tokenshield.activeStrategies": {
    "codeGraph": true,
    "outputCompression": true,
    "verbosityControl": true,
    "sessionManagement": true,
    "semanticCache": true,
    "astSkeleton": true,
    "contextExclusion": true,
    "diffOnlyOutput": true,
    "agentGuardrails": true,
    "smartModelRouting": true,
    "gitDiffContext": true,
    "rangeSlicing": true,
    "inlineChatScopePinning": true,
    "kvCacheAlignment": true,
    "headroomCompression": true,
    "copilotEditsAwareness": true,
    "testFailureIsolator": true,
    "commentStripper": true,
    "copilotIgnoreGeneration": true,
    "threadResetTrigger": true
  },
  "tokenshield.profile": "full"
}